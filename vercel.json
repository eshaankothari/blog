{
  "redirects": [
    { "source": "/", "destination": "/blog/", "permanent": false },
    { "source": "/blog", "destination": "/blog/", "permanent": false },
    { "source": "/posts", "destination": "/blog/", "permanent": false },
    { "source": "/posts/:path*", "destination": "/blog/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/blog/", "destination": "/posts/index.html" },
    { "source": "/blog/:path*", "destination": "/posts/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
