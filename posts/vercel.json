{
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/blog", "permanent": false },
    { "source": "/index.html", "destination": "/blog", "permanent": false },
    { "source": "/blog/index.html", "destination": "/blog", "permanent": false },
    { "source": "/blog/:slug/index.html", "destination": "/blog/:slug", "permanent": false },
    { "source": "/data_center_deals/:path*", "destination": "/blog/data_center_deals/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/:slug", "destination": "/:slug/index.html" },
    { "source": "/blog/:path*", "destination": "/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
